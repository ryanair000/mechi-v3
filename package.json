{
  "name": "mechi-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "android:dev": "npm --prefix apps/android run dev:usb",
    "android:usb": "npm --prefix apps/android run android:usb",
    "android:typecheck": "npm --prefix apps/android run typecheck",
    "build": "next build --webpack",
    "check:v5-cutover": "node ./scripts/check-v5-cutover.mjs",
    "start": "next start",
    "import:registrations": "node ./scripts/import-registration-feed.mjs",
    "ops:instagram:check": "node ./scripts/openclaw-instagram-check.mjs",
    "ops:android-testers": "node ./scripts/export-android-testers.mjs",
    "ops:registrations": "node ./scripts/openclaw-supabase-summary.mjs",
    "ops:tournaments": "node ./scripts/openclaw-tournaments-summary.mjs",
    "ops:daily-report:telegram": "node ./scripts/openclaw-daily-mechi-report.mjs",
    "ops:whatsapp-qr": "node ./scripts/openclaw-whatsapp-qr.mjs",
    "ops:ses:smoke": "node ./scripts/aws-ses-smoke-test.mjs",
    "ops:email:welcome-backfill": "node ./scripts/send-welcome-backfill.mjs",
    "ops:email:weekendcup-phase-closing": "node ./scripts/send-weekendcup-phase-closing.mjs",
    "start:e2e": "npm run build && npm run start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "release:quality": "node ./scripts/verify-v5-release.mjs quality",
    "release:database": "node ./scripts/verify-v5-release.mjs database",
    "release:e2e": "node ./scripts/verify-v5-release.mjs e2e",
    "release:preview": "node ./scripts/verify-v5-release.mjs preview",
    "release:verify": "node ./scripts/verify-v5-release.mjs all",
    "test:e2e": "node ./e2e/scripts/run-playwright.mjs",
    "test:e2e:public-auth": "node ./e2e/scripts/run-playwright.mjs --project=desktop-core e2e/specs/public-auth.spec.ts",
    "test:e2e:player-desktop": "node ./e2e/scripts/run-playwright.mjs --project=desktop-core e2e/specs/player-pages.spec.ts e2e/specs/competition-flows.spec.ts",
    "test:e2e:player-mobile": "node ./e2e/scripts/run-playwright.mjs --project=mobile-core",
    "test:e2e:core": "node ./e2e/scripts/run-playwright.mjs --project=desktop-core --project=mobile-core",
    "test:e2e:admin": "node ./e2e/scripts/run-playwright.mjs --project=admin",
    "test:e2e:provider-mock": "node ./e2e/scripts/run-playwright.mjs --project=providers-mock",
    "test:e2e:workspaces": "node ./e2e/scripts/run-playwright.mjs --project=workspaces",
    "test:e2e:provider-sandbox": "node ./e2e/scripts/run-playwright.mjs --provider-mode=sandbox --project=providers-sandbox",
    "test:e2e:cross-browser": "node ./e2e/scripts/run-playwright.mjs --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit",
    "test:e2e:headed": "node ./e2e/scripts/run-playwright.mjs --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@mux/mux-node": "^14.0.1",
    "@mux/mux-player-react": "^3.11.8",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.76",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "posthog-js": "^1.406.1",
    "posthog-node": "^5.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-use-measure": "^2.1.7",
    "resend": "^6.12.3",
    "tesseract.js": "^5.1.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "dompurify": "^3.4.12",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.7"
    },
    "postcss": "^8.5.13",
    "sharp": "^0.35.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4.2.4",
    "typescript": "^5"
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with create-next-app.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanair000/mechi-v3.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ryanair000/mechi-v3/issues"
  },
  "homepage": "https://github.com/ryanair000/mechi-v3#readme"
}
